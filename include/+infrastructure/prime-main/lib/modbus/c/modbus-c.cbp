<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="modbus-c" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Master">
				<Option output="bin/Master/modbus-c" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Master/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DMODBUS_ENABLE_ALL_CHECKS" />
					<Add option="-D_MODBUS_EXTEND_CALLBACKS" />
					<Add option="-DMODBUS_DEBUG" />
					<Add option="-DSYSTEM_TRACE_SERIAL_PORT" />
				</Compiler>
			</Target>
			<Target title="Slave">
