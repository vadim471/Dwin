<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="itp-c" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/itp-c" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DITP_ENABLE_ALL_CHECKS" />
					<Add option="-DITP_DEBUG_CUSTOM" />
					<Add option="-D_ITP_TRACE_BUFFERS" />
					<Add option="-DITP_USE_STACK_TRACE" />
					<Add option="-DITP_BUFFER_SIZE=0xFFFF" />
				</Compiler>
				<Linker>
					<Add library="backtrace" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/itp-c" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="3" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-fPIC" />
					<Add option="-DITP_EXTEND_CALLBACKS" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-static-libgcc" />
				</Linker>
			</Target>
			<Target title="Memory">
				<Option output="bin/Memory/itp-c" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Memory/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DITP_ENABLE_ALL_CHECKS" />
					<Add option="-DITP_MEMORY_CUSTOM" />
					<Add option="-DITP_DEBUG_CUSTOM" />
					<Add option="-DITP_TRACE_BUFFERS" />
					<Add option="-DITP_BUFFER_SIZE=64" />
					<Add option="-DITP_WAIT_ACKNOWLEDGE=2000" />
					<Add option="-DITP_WAIT_DATA=2000" />
					<Add option="-DITP_MAX_INPUT_PACKAGES=50" />
					<Add option="-DITP_MAX_OUTPUT_PACKAGES=50" />
					<Add option="-DITP_MAX_PENDING_FRAMES=50" />
					<Add option="-DTEST_FRAMES_COUNT=50" />
					<Add option="-DTEST_DATA_SIZE=30" />
				</Compiler>
			</Target>
			<Target title="Pending">
				<Option output="bin/Pending/itp-c" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Pending/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DITP_DEBUG_CUSTOM" />
					<Add option="-DITP_TRACE_BUFFERS" />
				</Compiler>
			</Target>
			<Target title="List">
				<Option output="bin/List/itp-c" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/List/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DITP_MEMORY_CUSTOM" />
					<Add option="-DITP_DEBUG_CUSTOM" />
					<Add option="-DITP_TRACE_BUFFERS" />
				</Compiler>
			</Target>
			<Target title="Queue">
				<Option output="bin/Queue/itp-c" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Queue/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DITP_DEBUG" />
					<Add option="-DITP_MEMORY_CUSTOM" />
					<Add option="-DITP_TRACE_BUFFERS" />
				</Compiler>
			</Target>
			<Target title="Tests">
				<Option output="bin/Bus/itp-c" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Bus/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DITP_DEBUG_CUSTOM" />
					<Add option="-DITP_TRACE_BUFFERS" />
				</Compiler>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=c++11" />
			<Add option="-DPOSIX" />
			<Add option="-D_DEFAULT_SOURCE" />
			<Add directory="include" />
